<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the PluginSdk configuration envelope of a plugin's defaults. Build/prepare-concealment.py
       runs it for the bundled Concealment; it loads PluginSdk and the plugin by path, without references. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunPostBuildEvent>Never</RunPostBuildEvent>
  </PropertyGroup>
</Project>
