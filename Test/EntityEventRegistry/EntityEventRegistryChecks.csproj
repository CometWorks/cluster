<Project Sdk="Microsoft.NET.Sdk">
  <!-- SE-1313: entity-event registrations from parallel builder threads, as the staged
       handover import makes them. Needs the dedicated server's assemblies, no game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ClusterNodePlugin/ClusterNodePlugin.csproj" AdditionalProperties="RunPostBuildEvent=Never" />
    <Reference Include="Sandbox.Game" HintPath="$(Dedicated64Dir)Sandbox.Game.dll" Private="False" />
    <Reference Include="SpaceEngineers.Game" HintPath="$(Dedicated64Dir)SpaceEngineers.Game.dll" Private="False" />
    <Reference Include="VRage" HintPath="$(Dedicated64Dir)VRage.dll" Private="False" />
    <Reference Include="VRage.Game" HintPath="$(Dedicated64Dir)VRage.Game.dll" Private="False" />
    <Reference Include="VRage.Library" HintPath="$(Dedicated64Dir)VRage.Library.dll" Private="False" />
    <!-- The game assemblies are loaded from the server's folder at run time (Program.cs). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Dedicated64Dir</_Parameter1>
      <_Parameter2>$(Dedicated64Dir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
