# Host contract of the cluster scenario suite. Copy to host.env (gitignored) and set what differs
# on this host; every line is optional. Values may use ~ and $VARS. The environment wins over
# this file. `uv run python doctor.py` checks the result.

# The unpacked release package under test (Build/release.sh output, or a downloaded
# ClusterForLinux-<version>.tar.gz unpacked). Default: the newest one under Build/dist or Build/out.
#CLUSTER_PACKAGE=~/ws/se/se1/cluster/Build/dist/cluster-1.0.2

# Game installs. The client build must match the server build.
#SPACE_ENGINEERS_SERVER=~/.steam/steam/steamapps/common/SpaceEngineersDedicatedServer
#SPACE_ENGINEERS_ROOT=~/.steam/steam/steamapps/common/SpaceEngineers

# Launchers. Magnetar runs the nodes; Pulsar runs the headless clients, and its Interim/ profile
# must enable the `remote` and `direct-transport` client plugins.
#MAGNETAR_HOME=~/.config/Magnetar
#PULSAR_HOME=~/.config/Pulsar

# The se-remote skill folder holding se_remote.py (CometWorks/remote, skills/se-remote). It must
# match the Remote plugin the Pulsar profile loads.
#SE_REMOTE_SKILL=~/ws/se/se1/plugins/remote/skills/se-remote

# Where clusters run and where evidence lands. Never under /tmp (tmpfs; crash dumps are kept).
#CLUSTER_TEST_ROOT=~/cluster-runs/bench
#CLUSTER_TEST_RESULTS=~/cluster-test-results/bench

# Offset added to every cluster port (Gateway control 29416, Direct Transport 27116, node
# backends 28416+i, controls 29416+i), so the suite can share the host with another cluster.
# 0 = the CLI defaults.
#CLUSTER_TEST_PORT_BASE=100
# Remote API ports of the suite's clients (base, base+1, ...). 24158 is the interactive client's.
#CLUSTER_TEST_REMOTE_PORT_BASE=24200

# A daily local window no scenario may overlap (HH:MM-HH:MM), e.g. an ISP router restart or a
# cron job that kills game clients. Empty = none.
#CLUSTER_TEST_NETWORK_WINDOW=03:45-04:07
# The longest one scenario may take, for the window guard.
#CLUSTER_TEST_SCENARIO_BUDGET_MINUTES=30

# 0 on a host without a usable GPU: every client runs --no-render and screenshot scenarios are
# deferred. Never --no-gpu.
#CLUSTER_TEST_RENDER=1
# RAM floor (GB, MemAvailable) below which no scenario starts.
#CLUSTER_TEST_MIN_FREE_GB=10

# Fixtures.
#PLANET_WORLD_ARCHIVE=~/ws/se/se1/plugins/remote/Worlds/RemoteAPITestEarthPlanet.zip
#TEST_PLAN=~/ws/se/se1/clustering-plan/Plan/TestPlan.md

# The second host with a retail Steam client for the Steam scenarios (Phase 3 AUT/PUB); empty
# defers them. The Steam lane has no native port yet, so on a host that sets these, coverage.py
# reports those ids as unported rather than deferred.
#STEAM_CLIENT_HOST=
#STEAM_CLIENT_USER=
#STEAM_CLIENT_ID=

# Unset (the default) takes Direct Transport from the Magnetar hub, the same pin the game clients
# load - which is the rule since 2026-09-20 and the reason there is no checkout on the host any
# more. Set this to a checkout only to test a transport change before it is published; its commit
# is then what the package records, and nodes and clients can disagree until you unset it again.
#DIRECT_TRANSPORT_SOURCE=/path/to/direct-transport

# 0 runs without the test utility plugin (ClusterTestPlugin/), e.g. to check the production
# route surface by hand. Scenarios that use test-only routes then fail.
#CLUSTER_TEST_PLUGIN=1
