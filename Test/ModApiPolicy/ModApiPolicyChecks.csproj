<Project Sdk="Microsoft.NET.Sdk">
  <!-- SE-1840: checks Shared/Cluster/ModApiPolicyTable.cs against the game's mod API.
       usage: dotnet run (project Test/ModApiPolicy/ModApiPolicyChecks.csproj, Release), optionally followed by the
       DedicatedServer64 folder after the double-dash separator. The folder defaults to $DEDICATED64, then $SPACE_ENGINEERS_BIN64, then the Steam install of the Dedicated Server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RunPostBuildEvent>Never</RunPostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/Cluster/ModApiPolicyTable.cs" Link="ModApiPolicyTable.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(Dedicated64Dir)Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(Dedicated64Dir)Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../Tools/ModCompatScan/ScriptReferences.cs" Link="ScriptReferences.cs" />
    <None Update="CorpusMembers.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
