<Project Sdk="Microsoft.NET.Sdk">
  <!-- The dedicated server supplies Roslyn for the Workshop source checks. See Docs/ModCompat.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RunPostBuildEvent>Never</RunPostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/Cluster/ModApiPolicyTable.cs" Link="ModApiPolicyTable.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(Dedicated64Dir)Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(Dedicated64Dir)Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../Tools/ModCompatScan/ScriptReferences.cs" Link="ScriptReferences.cs" />
    <None Update="CorpusMembers.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
