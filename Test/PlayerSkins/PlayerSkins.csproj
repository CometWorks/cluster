<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Compile Include="../../Shared/Cluster/PlayerEntitlements.cs" Link="PlayerEntitlements.cs" />
    <Compile Include="../../Shared/Patches/PlayerEntitlementsPatch.cs" Link="PlayerEntitlementsPatch.cs" />
    <!-- Include the former discard patch if it is reintroduced, so it cannot silently swallow requests again. -->
    <Compile Include="../../Shared/Cluster/Patches/GameInventoryRequestPatch.cs" Link="GameInventoryRequestPatch.cs"
             Condition="Exists('../../Shared/Cluster/Patches/GameInventoryRequestPatch.cs')" />
  </ItemGroup>
</Project>
